{
  "name": "nst-attendance",
  "version": "0.2.0",
  "type": "module",
  "description": "Chrome extension that combines lecture and lab attendance per subject on the Newton School portal, and tells you how many classes you can still skip.",
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check-release.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "package": "node scripts/build-mobile.mjs && sh scripts/package.sh",
    "shots:store": "sh dev/shots/capture.sh",
    "set-version": "node scripts/set-version.mjs",
    "serve": "python3 dev/serve.py 8731"
  },
  "license": "MIT",
  "author": "Yatharth Katta",
  "homepage": "https://github.com/yats0x7/nst-attendance#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yats0x7/nst-attendance.git"
  },
  "bugs": {
    "url": "https://github.com/yats0x7/nst-attendance/issues"
  },
  "keywords": [
    "chrome-extension",
    "attendance",
    "newton-school",
    "manifest-v3"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "manifest.json",
    "icons",
    "src"
  ]
}
